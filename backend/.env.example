# Copy to .env and fill in. Every variable is validated at startup by src/config/env.ts;
# the app refuses to boot if a required one is missing or malformed.
# Variables with a default are shown commented out — uncomment to override.

# --- App ---
# NODE_ENV=development          # development | test | production
# PORT=4000
# FRONTEND_URL="http://localhost:3000"   # CORS, for Swagger and local tools only (D1)
# APP_URL="http://localhost:3000"        # frontend URL: links in emails, Paystack callback

# --- Database (Neon Postgres) ---
# Pooled connection, used by the app at runtime
DATABASE_URL="postgresql://neondb_owner:your_database_password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct (unpooled) connection, used by the Prisma CLI for migrations
DIRECT_URL="postgresql://neondb_owner:your_database_password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Only for `prisma migrate diff --from-migrations` (CI drift check); any throwaway database
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# --- Auth ---
JWT_SECRET="at-least-32-random-characters-please-change-me"

# --- Mail (SMTP, Phase 1). Required in production; in development emails print to the console. ---
# MAIL_HOST="smtp.example.com"
# MAIL_PORT=587
# MAIL_USER="noreply@campusmart.com"
# MAIL_PASS="your_email_password"
# MAIL_FROM="CampusMart <noreply@campusmart.com>"

# --- Cloudinary (image uploads, Phase 3) ---
# CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
# CLOUDINARY_API_KEY="your_cloudinary_api_key"
# CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# --- Paystack (payments, Phase 5). Required once PAYMENTS_ENABLED=true. ---
# PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
# PAYMENTS_ENABLED=false        # true/false, 1/0, yes/no, on/off
# PAYSTACK_WALLET_CHANNELS=false   # OPay and PalmPay, once Paystack confirms them (P5)
# PAYSTACK_WEBHOOK_IPS="52.31.139.75,52.49.173.169,52.214.14.220"   # checked in production

# --- Google sign-in for buyers (Phase 10). Without both, the button stays hidden. ---
# GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your_google_client_secret"
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"   # defaults to APP_URL/api/auth/google/callback

# --- Support contacts on Help (Phase 10). Each one unset shows "coming soon". ---
# SUPPORT_EMAIL="support@campusmart.com"
# SUPPORT_PHONE="+2348000000000"
# SUPPORT_WHATSAPP="+2348000000000"

# --- Error reporting (Sentry, Phase 10). Unset means errors go to the logs only. ---
# SENTRY_DSN="https://your_key@o0.ingest.sentry.io/0"
# SENTRY_ENVIRONMENT="staging"  # defaults to NODE_ENV

# --- Marketplace rules ---
# PLATFORM_FEE_BPS=0            # basis points; 100 = 1%
# ORDER_PAYMENT_TTL_MINUTES=30
# DROP_OFF_DEADLINE_DAYS=3
# BUYER_COLLECT_DAYS=5
# ESCROW_DISPUTE_WINDOW_HOURS=48   # set 0 to test the release cron
# LOW_STOCK_THRESHOLD=5
# Trust-score weights (guide 8.4); admins can change them in settings
# TRUST_WEIGHT_RATING=50
# TRUST_WEIGHT_COMPLETED=30
# TRUST_WEIGHT_VERIFIED=20
# TRUST_PENALTY_SELLER_FAULT=10

# --- Seed admin (prisma/seed.ts only, Phase 2) ---
# SEED_ADMIN_EMAIL="admin@campusmart.com"
# SEED_ADMIN_PASSWORD="change_me"
