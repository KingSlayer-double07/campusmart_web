generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailCodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  password             String?
  googleId             String?               @unique
  username             String?               @unique
  firstName            String?
  lastName             String?
  phone                String?
  role                 UserRole
  trustScore           Float                 @default(0)
  verificationStatus   VerificationStatus    @default(UNVERIFIED)
  isActive             Boolean               @default(true)
  isSuspended          Boolean               @default(false)
  institutionId        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  emailVerifiedAt      DateTime?
  sessions             Session[]
  emailCodes           EmailCode[]
  listings             Listing[]             @relation("SellerListings")
  moderationActions    ModerationAction[]
  orders               Order[]               @relation("BuyerOrders")
  reviewsReceived      Review?               @relation("Reviewee")
  reviewsGiven         Review[]              @relation("Reviewer")
  institution          Institution?          @relation(fields: [institutionId], references: [id])
  verificationRequests VerificationRequest[]
  wishlist             Wishlist[]
}

model Session {
  id                  String      @id @default(uuid())
  userId              String
  refreshTokenHash    String
  userAgent           String?
  ipAddress           String?
  lastUsedAt          DateTime    @default(now())
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime    @default(now())
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model EmailCode {
  id                String      @id @default(uuid())
  userId            String
  purpose           EmailCodePurpose
  codeHash          String
  attempts          Int         @default(0)
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime    @default(now())
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Institution {
  id        String    @id @default(uuid())
  name      String    @unique
  domains   String[]
  createdAt DateTime  @default(now())
  listings  Listing[]
  users     User[]
}

model Listing {
  id             String             @id @default(uuid())
  title          String
  description    String
  price          Decimal            @db.Decimal(10, 2)
  quantity       Int
  category       ListingCategory
  status         ListingStatus      @default(DRAFT)
  condition      ProductCondition
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  isDeleted      Boolean            @default(false)
  isPromoted     Boolean            @default(false)
  isFlagged      Boolean            @default(false)
  sellerId       String
  institutionId  String?
  institution    Institution?       @relation(fields: [institutionId], references: [id])
  seller         User               @relation("SellerListings", fields: [sellerId], references: [id])
  images         ListingImage[]
  moderationLogs ModerationAction[]
  orderItems     OrderItem[]
  reviews        Review[]
  wishlistedBy   Wishlist[]

  @@index([sellerId, status, institutionId])
}

model ListingImage {
  id        String  @id @default(uuid())
  url       String
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
}

model Order {
  id                String             @id @default(uuid())
  status            OrderStatus        @default(CART)
  fulfillmentStatus FulfillmentStatus?
  totalAmount       Decimal            @db.Decimal(10, 2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  buyerId           String
  buyer             User               @relation("BuyerOrders", fields: [buyerId], references: [id])
  items             OrderItem[]
  payment           Payment?
  review            Review?

  @@index([buyerId, status])
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  orderId   String
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  order     Order   @relation(fields: [orderId], references: [id])

  @@unique([orderId, listingId])
}

model Payment {
  id        String        @id @default(uuid())
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)
  provider  String?
  reference String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  orderId   String        @unique
  order     Order         @relation(fields: [orderId], references: [id])
}

model Review {
  id         String   @id @default(uuid())
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  reviewerId String
  revieweeId String   @unique
  listingId  String
  orderId    String   @unique
  listing    Listing  @relation(fields: [listingId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id])
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])

  @@index([revieweeId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, listingId])
  @@index([userId, listingId])
}

model VerificationRequest {
  id          String             @id @default(uuid())
  status      VerificationStatus @default(PENDING)
  documentUrl String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  userId      String
  user        User               @relation(fields: [userId], references: [id])
}

model ModerationAction {
  id          String               @id @default(uuid())
  type        ModerationActionType
  reason      String?
  createdAt   DateTime             @default(now())
  listingId   String?
  moderatorId String
  listing     Listing?             @relation(fields: [listingId], references: [id])
  moderator   User                 @relation(fields: [moderatorId], references: [id])
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum OrderStatus {
  CART
  AWAITING_PAYMENT
  PAID
  DISPUTED
  CANCELLED
}

enum FulfillmentStatus {
  AWAITING_DROPOFF
  DROPPED_OFF
  COLLECTED
  CANCELLED
  DISPUTED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLDOUT
  ARCHIVED
  FLAGGED
}

enum ProductCondition {
  NEW
  USED_LIKE_NEW
  USED_GOOD
  USED_FAIR
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ModerationActionType {
  APPROVE
  REJECT
  SUSPEND
  FLAG
}

enum ListingCategory {
  FASHION
  BEAUTY
  FOOD
  CREATIVE
  TECH
  SERVICES
  OTHERS
}
