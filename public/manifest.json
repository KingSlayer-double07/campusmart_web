{
  "name": "Campusmart",
  "short_name": "Campusmart",
  "start_url": "/?source=pwa",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "minimal-ui"],
  "description": "Campusmart PWA helps you buy and sell various kinds of products from the comfort of your home.",
  "background_color": "#ffffff",
  "theme_color": "#ff681f",
  "categories": ["shopping", "education", "lifestyle"],
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "any",
      "type": "image/x-icon"
    },
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Search Products",
      "url": "/search",
      "icons": [{ "src": "/favicon.ico", "sizes": "any" }]
    },
    {
      "name": "My Cart",
      "url": "/cart",
      "icons": [{ "src": "/favicon.ico", "sizes": "any" }]
    }
  ],
  "orientation": "portrait-primary",
  "prefer_related_applications": false
}
